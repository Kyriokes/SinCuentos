# Cabeceras para hostings que leen este archivo (Netlify, Cloudflare Pages). En Vercel van en vercel.json.
# La CSP completa va como <meta> en el HTML del build (vite.config.ts); acá se suma lo que una <meta> no puede hacer.
/*
  Content-Security-Policy: frame-ancestors 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

# Los archivos de /assets llevan un hash en el nombre: nunca cambian, se pueden guardar un año.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
